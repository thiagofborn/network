# Shared router connection settings for setup_openvpn.sh / new-client.sh
# when run from your workstation instead of directly on the router.
# Edit these to match your setup. No secrets belong here — for a key,
# reference its path only.

ROUTER_HOST="192.168.8.1"
ROUTER_PORT="22"
ROUTER_USER="root"
ROUTER_SSH_KEY=""    # e.g. "$HOME/.ssh/id_rsa" — leave empty to use ssh-agent/default identity
